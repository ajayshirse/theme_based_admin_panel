{
  "themeId": "eye_theme1",
  "label": "VisionCare Eye Clinic — Clean Clinical Theme",
  "industry": "healthcare",
  "subIndustry": "eye",
  "type": "single-page",
  "themeType": "clean-clinical",
  "description": "A bright, trustworthy single-page eye clinic theme with split hero, service cards, animated stats, about section with testimonial, appointment banner and footer.",
  "previewUrl": "/healthcare/eye/eye_theme1/index.html",
  "pages": [
    {
      "id": "single",
      "label": "Single Page",
