      "sections": [
        {
          "id": "brand",
          "label": "Brand & Logo",
          "type": "single",
          "fields": [
            {
              "name": "logoIcon",
              "label": "Logo Icon (Lucide name)",
              "type": "text",
              "required": true,
              "placeholder": "eye",
              "hint": "Any icon name from lucide.dev"
            },
            {
              "name": "brandName",
              "label": "Brand Name",
              "type": "text",
              "required": true,
              "placeholder": "Vision"
            },
            {
              "name": "brandSuffix",
              "label": "Brand Suffix (colored)",
              "type": "text",
              "placeholder": "Care"
            },
            {
              "name": "brandTagline",
              "label": "Tagline under logo",
              "type": "text",
              "placeholder": "EYE CLINIC"
            }
